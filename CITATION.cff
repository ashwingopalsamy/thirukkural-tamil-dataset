cff-version: 1.2.0
message: "If you use this dataset, please cite it as below. To cite one kural, add its id (tk:0001 to tk:1330) and its text_sha256."
type: dataset
title: "Thirukkural Tamil Dataset"
version: "1.0.0"
date-released: "2026-10-20"
license:
